<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLow"
    android:clipToPadding="false"
    android:scrollbarStyle="outsideOverlay">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp" android:paddingTop="16dp" android:paddingBottom="32dp">

        <!-- Account Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:strokeWidth="0dp" app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingVertical="8dp">

                <!-- Profile row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="20dp" android:paddingVertical="12dp">
                    <ImageView
                        android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_person_placeholder"
                        android:contentDescription="Profile"
                        app:tint="?attr/colorPrimary"/>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:id="@+id/tvSettingsUserName"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:text="@string/settings_signed_in"/>
                        <TextView android:id="@+id/tvSettingsUserSubtitle"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_tap_sign_out"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Biometric Login -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp" android:paddingVertical="12dp">
                    <ImageView
                        android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_fingerprint"
                        android:contentDescription="Biometric Login"
                        app:tint="?attr/colorOnSurfaceVariant"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Biometric Login"
                        android:textAppearance="?attr/textAppearanceBodyLarge"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBiometric"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:minHeight="0dp"/>
                </LinearLayout>

                <!-- Inset divider (starts after icon area: 20dp pad + 24dp icon + 16dp margin = 60dp) -->
                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:background="?attr/colorOutlineVariant"
                    android:layout_marginStart="60dp"/>

                <!-- Sign Out -->
                <LinearLayout android:id="@+id/layoutSignOut"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="20dp" android:paddingVertical="12dp">
                    <ImageView
                        android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_logout"
                        android:contentDescription="Sign out"
                        app:tint="?attr/colorError"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/btn_sign_out"
                        android:textColor="?attr/colorError"
                        android:textAppearance="?attr/textAppearanceBodyLarge"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- Appearance Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:strokeWidth="0dp" app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingVertical="8dp">

                <!-- Theme -->
                <LinearLayout android:id="@+id/layoutThemePicker"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="20dp" android:paddingVertical="12dp">
                    <ImageView
                        android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_palette"
                        android:contentDescription="Theme"
                        app:tint="?attr/colorOnSurfaceVariant"/>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/settings_theme"
                            android:textAppearance="?attr/textAppearanceBodyLarge"/>
                        <TextView android:id="@+id/tvCurrentTheme"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Inset divider -->
                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:background="?attr/colorOutlineVariant"
                    android:layout_marginStart="60dp"/>

                <!-- Font Size -->
                <LinearLayout android:id="@+id/layoutFontSize"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="20dp" android:paddingVertical="12dp">
                    <ImageView
                        android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_font_size"
                        android:contentDescription="Font size"
                        app:tint="?attr/colorOnSurfaceVariant"/>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/settings_font_size"
                            android:textAppearance="?attr/textAppearanceBodyLarge"/>
                        <TextView android:id="@+id/tvCurrentFontSize"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Inset divider -->
                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:background="?attr/colorOutlineVariant"
                    android:layout_marginStart="60dp"/>

                <!-- Bold Text -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp" android:paddingVertical="12dp">
                    <ImageView
                        android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_format_bold"
                        android:contentDescription="Bold"
                        app:tint="?attr/colorOnSurfaceVariant"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_bold"
                        android:textAppearance="?attr/textAppearanceBodyLarge"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBold"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:minHeight="0dp"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
