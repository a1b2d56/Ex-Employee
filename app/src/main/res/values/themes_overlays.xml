<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Custom theme overlays — each one overrides Material3 color tokens.
      Applied at runtime in ExEmployeeApp via ContextThemeWrapper.
      Dynamic themes (LIGHT/DARK/SYSTEM/MIDNIGHT) use sky-blue fallback on A11-;
      on A12+ DynamicColors.applyToActivitiesIfAvailable() handles everything.
    -->

    <!-- Surface-only overlay for Light mode on A12+ (keeps dynamic accents, fixes surfaces) -->
    <style name="ThemeOverlay.ExEmployee.SurfaceLight" parent="">
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorSurfaceVariant">@color/surface_light_container</item>
        <item name="colorSurfaceContainerLow">@color/surface_light_containerLow</item>
        <item name="colorSurfaceContainer">@color/surface_light_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_light_containerHigh</item>
        <item name="colorOutlineVariant">@color/surface_light_outlineVariant</item>
    </style>

    <!-- Surface-only overlay for Dark mode on A12+ (keeps dynamic accents, fixes surfaces) -->
    <style name="ThemeOverlay.ExEmployee.SurfaceDark" parent="">
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">#E2E2E6</item>
        <item name="colorSurfaceVariant">@color/surface_dark_container</item>
        <item name="colorSurfaceContainerLow">@color/surface_dark_containerLow</item>
        <item name="colorSurfaceContainer">@color/surface_dark_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_dark_containerHigh</item>
        <item name="colorOutlineVariant">@color/surface_dark_outlineVariant</item>
    </style>

    <!-- Sky Blue fallback for Light mode (A11-) -->
    <style name="ThemeOverlay.ExEmployee.FallbackLight" parent="">
        <item name="colorPrimary">@color/fallback_light_primary</item>
        <item name="colorOnPrimary">@color/fallback_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/fallback_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/fallback_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/fallback_light_secondary</item>
        <item name="colorOnSecondary">@color/fallback_light_onSecondary</item>
        <item name="colorSurface">@color/fallback_light_surface</item>
        <item name="colorOnSurface">@color/fallback_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/fallback_light_surfaceVariant</item>
        <item name="colorSurfaceContainerLow">@color/fallback_light_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/fallback_light_surfaceVariant</item>
        <item name="colorOutlineVariant">@color/fallback_light_outlineVariant</item>
        <item name="colorError">@color/fallback_light_error</item>
    </style>

    <!-- Sky Blue fallback for Dark mode (A11-) -->
    <style name="ThemeOverlay.ExEmployee.FallbackDark" parent="">
        <item name="colorPrimary">@color/fallback_dark_primary</item>
        <item name="colorOnPrimary">@color/fallback_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/fallback_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/fallback_dark_onPrimaryContainer</item>
        <item name="colorSecondary">@color/fallback_dark_secondary</item>
        <item name="colorOnSecondary">@color/fallback_dark_onSecondary</item>
        <item name="colorSurface">@color/fallback_dark_surface</item>
        <item name="colorOnSurface">@color/fallback_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/fallback_dark_surfaceVariant</item>
        <item name="colorSurfaceContainerLow">@color/fallback_dark_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/fallback_dark_surfaceVariant</item>
        <item name="colorOutlineVariant">@color/fallback_dark_outlineVariant</item>
        <item name="colorError">@color/fallback_dark_error</item>
    </style>

    <!-- Midnight AMOLED (pure black backgrounds, accent from Dynamic/sky-blue) -->
    <style name="ThemeOverlay.ExEmployee.Midnight" parent="">
        <item name="colorSurface">@color/midnight_surface</item>
        <item name="colorOnSurface">@color/midnight_onSurface</item>
        <item name="colorSurfaceVariant">@color/midnight_surfaceVariant</item>
        <item name="colorSurfaceContainerLow">@color/midnight_background</item>
        <item name="colorSurfaceContainer">@color/midnight_surfaceContainer</item>
        <item name="colorOutlineVariant">@color/midnight_outline</item>
        <item name="android:windowBackground">@color/midnight_background</item>
    </style>

    <!-- Midnight + sky-blue fallback for A11- -->
    <style name="ThemeOverlay.ExEmployee.MidnightFallback" parent="">
        <item name="colorPrimary">@color/fallback_dark_primary</item>
        <item name="colorOnPrimary">@color/fallback_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/fallback_dark_primaryContainer</item>
