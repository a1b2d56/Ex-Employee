<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Material3 theme — PowerGrid brand (deep blue / orange).
      On Android 12+ (API 31+), DynamicColors in ExEmployeeApp overrides these with
      the wallpaper palette (Material You). On Android 7-11 these static colors are used.
    -->
    <style name="Theme.ExEmployee" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorError">@color/md_theme_error</item>
        <item name="android:windowBackground">@color/md_theme_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.ExEmployee.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.ExEmployee.BodyMedium</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.ExEmployee.TitleLarge</item>
    </style>

    <!-- Slightly larger base sizes for senior-citizen readability -->
    <style name="TextAppearance.ExEmployee.BodyLarge"  parent="TextAppearance.Material3.BodyLarge">  <item name="android:textSize">17sp</item></style>
    <style name="TextAppearance.ExEmployee.BodyMedium" parent="TextAppearance.Material3.BodyMedium"> <item name="android:textSize">15sp</item></style>
    <style name="TextAppearance.ExEmployee.TitleLarge" parent="TextAppearance.Material3.TitleLarge"> <item name="android:textSize">22sp</item></style>

    <!-- Splash Screen compat theme (API 12+ backported via core-splashscreen) -->
    <style name="Theme.ExEmployee.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/md_theme_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ExEmployee</item>
    </style>

    <!-- ShapeableImageView circle overlay (profile avatars) -->
    <style name="ShapeAppearanceOverlay.App.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ShapeableImageView rounded-large overlay (app logo) -->
    <style name="ShapeAppearanceOverlay.App.RoundedLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Flat section header for settings-style screens -->
    <style name="Widget.ExEmployee.SectionHeader" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
</resources>
